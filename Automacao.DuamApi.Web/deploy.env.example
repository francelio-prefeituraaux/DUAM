# Copie este arquivo para "deploy.env.local" (já ignorado pelo git) e preencha
# com os valores reais antes de rodar ./deploy.sh
#
# Este script roda NO SERVIDOR, dentro da pasta Automacao.DuamApi.Web do
# repositório já clonado — não precisa de SSH_HOST nem rsync remoto.

# URL pública da API em produção, incluindo o prefixo do Nginx (/api).
# Embutida no JS no momento do build — precisa bater com o location /api/ do Nginx.
VITE_API_BASE_URL=https://SEU-DOMINIO-OU-IP/api

# Diretório local (no próprio servidor) onde o Nginx serve os arquivos estáticos
# (location / do Nginx). O usuário que roda este script precisa ter permissão de
# escrita aqui (ver README.md — "sudo chown deploy:deploy /var/www/duamapi-web").
TARGET_DIR=/var/www/duamapi-web
